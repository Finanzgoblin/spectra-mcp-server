{
  "name": "metavault-mcp",
  "version": "2.1.0",
  "description": "MetaVault MCP — multi-protocol yield intelligence for AI agents (Spectra, Morpho, Pendle)",
  "type": "module",
  "bin": {
    "metavault-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node test.cjs",
    "test:offline": "npm run build && node test.cjs --offline",
    "test:unit": "npm run build && node --test build/config.test.js build/formatters.test.js build/api.test.js build/schemas/spectra.test.js build/schemas/spectra.pt.test.js build/schemas/spectra.pools.test.js",
    "test:agent": "npm run build && node test-agent.cjs",
    "test:agent:offline": "npm run build && node test-agent.cjs --offline",
    "test:subjective": "npm run build && node test-subjective.cjs",
    "prepublishOnly": "npm run build && npm run test:offline"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "spectra",
    "metavault",
    "pendle",
    "defi",
    "yield",
    "ai-agent",
    "model-context-protocol",
    "principal-token",
    "morpho"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Finanzgoblin/metavault-mcp.git"
  },
  "mcpName": "io.github.Finanzgoblin/metavault-mcp",
  "homepage": "https://github.com/Finanzgoblin/metavault-mcp#readme",
  "bugs": {
    "url": "https://github.com/Finanzgoblin/metavault-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
